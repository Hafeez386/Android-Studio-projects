<?xml version="1.0" encoding="utf-8"?>
<!--
    FrameLayout:
    Blocks out an area on screen to display a single item or stacked layers of views.
    Child views are drawn in a stack (Z-order), where the last added child is drawn on top.
    Child positions are controlled via android:layout_gravity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    tools:context=".FrameLayoutActivity">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_color"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="FrameLayout Example"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section 1: Gravity Positioning in FrameLayout -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Layout Gravity Overlay Positions"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@color/card_bg"
                android:elevation="3dp">

                <!-- Layer 1: Background View -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E0F7FA" />

                <!-- Top Left Child -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@color/box_blue"
                    android:padding="8dp"
                    android:text="Top-Start"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <!-- Top Right Child -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@color/box_green"
                    android:padding="8dp"
                    android:text="Top-End"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <!-- Center Child -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@color/box_red"
                    android:padding="16dp"
                    android:text="CENTER OVERLAY"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <!-- Bottom Left Child -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@color/box_orange"
                    android:padding="8dp"
                    android:text="Bottom-Start"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <!-- Bottom Right Child -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@color/box_purple"
                    android:padding="8dp"
                    android:text="Bottom-End"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Section 2: Media Card with Play Button & Badge Overlay -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Video Card Overlay Example"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="@color/card_bg"
                android:elevation="4dp">

                <!-- Layer 1: Simulated Video Thumbnail (Background Image/View) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#37474F" />

                <!-- Layer 2: Center Play Button Overlay -->
                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:background="@color/accent_color"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="@color/white"
                    android:textSize="28sp" />

                <!-- Layer 3: Top Right "LIVE" Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@color/box_red"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="• LIVE"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Layer 4: Bottom Gradient / Title Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#99000000"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Android Development Masterclass"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Duration: 45:00 • 12K Viewers"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp" />
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>